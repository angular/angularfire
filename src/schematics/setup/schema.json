{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "angular-fire-ng-add",
    "title": "AngularFire ng-add",
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "description": "The name of the project.",
        "$default": {
          "$source": "projectName"
        }
      },
      "deploy": {
        "type": "string",
        "enum": ["apphosting", "hosting", "none"],
        "description": "Where ng deploy should deploy the app: Firebase App Hosting (apphosting), Firebase Hosting (hosting), or no deploy setup (none). Asked interactively when omitted."
      }
    },
    "required": []
  }
