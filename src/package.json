    "@angular/platform-server": { "optional": true },
    "typescript": { "optional": true }
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "rxfire": "^6.2.0",
    "@angular-devkit/architect": ">= 0.2200.0 < 0.2300.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@schematics/angular": "^22.0.0",
    "jsonc-parser": "^3.0.0",
