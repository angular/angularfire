{
  "$schema": "../node_modules/ng-packagr/package.schema.json",
  "name": "@angular/fire",
  "version": "ANGULARFIRE2_VERSION",
  "description": "Angular + Firebase = ❤️",
  "publishConfig": {
    "registry": "https://wombat-dressing-room.appspot.com",
