/**
 * @fileoverview Refreshes the list of Firebase App Hosting regions that `ng add` offers when it
 * creates a backend. A maintainer runs it before a release, signed in to the Firebase CLI:
 * `npm run update-regions -- <firebase project id>`. It rewrites
 * `src/schematics/setup/appHostingRegions.ts`, which is committed like any other source file.
 *
 * Node runs this file as it is, without a compile step, so it uses only TypeScript syntax that
 * Node can remove on its own (types and annotations).
 */

import { execSync } from 'node:child_process';
import { writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';

/** One region as the App Hosting API's `projects/<project>/locations` response lists it. */
export interface AppHostingLocation {
  locationId: string;
  displayName?: string;
}

const regionsFile = join(import.meta.dirname, '..', 'src', 'schematics', 'setup', 'appHostingRegions.ts');

/** Builds the TypeScript source of `appHostingRegions.ts` from the API's list of regions. */
export const regionsFileContent = (locations: AppHostingLocation[]): string => {
  const regions = locations
    .map(({ locationId, displayName }) => ({ id: locationId, name: displayName || locationId }))
    .sort((first, second) => first.id.localeCompare(second.id));
  const lines = regions.map(({ id, name }) => `  { id: ${JSON.stringify(id)}, name: ${JSON.stringify(name)} },`);
  return [
    '/**',
    ' * @fileoverview The Firebase App Hosting regions `ng add` offers for a new backend.',
    ' * Generated by `npm run update-regions`. Do not edit by hand.',
    ' */',
    '',
    'export const appHostingRegions = [',
    ...lines,
    '];',
    '',
  ].join('\n');
};

/**
 * Fetches the regions with the Firebase CLI's signed-in account. No Firebase CLI command lists
 * them, so this loads the globally installed firebase-tools' own modules.
 * @param projectId any Firebase project the signed-in account can read
 */
const fetchLocations = async (projectId: string): Promise<AppHostingLocation[]> => {
  const firebaseToolsRoot = join(execSync('npm root -g').toString().trim(), 'firebase-tools');
  const loadFirebaseToolsModule = createRequire(join(firebaseToolsRoot, 'package.json'));
  const { getGlobalDefaultAccount } = loadFirebaseToolsModule('./lib/auth');
  const { requireAuth } = loadFirebaseToolsModule('./lib/requireAuth');
  const { listLocations } = loadFirebaseToolsModule('./lib/gcp/apphosting');

  const account = getGlobalDefaultAccount();
  await requireAuth({ user: account?.user, tokens: account?.tokens });
  return listLocations(projectId);
};

const main = async (): Promise<void> => {
  const projectId = process.argv[2];
  if (!projectId) {
    throw new Error('Usage: npm run update-regions -- <firebase project id>');
  }
  const locations = await fetchLocations(projectId);
  if (!locations.length) {
    throw new Error(`The App Hosting API returned no regions for project ${projectId}.`);
  }
  writeFileSync(regionsFile, regionsFileContent(locations));
  console.log(`Wrote ${locations.length} regions to ${regionsFile}`);
};

// Only when run as a script, so importing this file fetches nothing.
if (import.meta.main) {
  main().catch((error: Error) => {
    console.error(error.message);
    process.exit(1);
  });
}
